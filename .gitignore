# Root ignore (Backend/ and Frontend/ have their own .gitignore)
node_modules/
dist/
.env
.env.*
!.env.example
.vs/
# Agent config is SHARED (tracked): .claude/ (settings, launch, skills mirror), .agents/skills, .codex/rules.
# Only machine-local / credential / runtime files are ignored:
.claude/settings.local.json
.claude/worktrees/
.codex/*
!.codex/rules/
.harness/
# Generated from GitHub Issues (harness/sync-issues.mjs; start-ticket and CI regenerate it). Never commit it.
.spec/tasks.md
.gemini/
*.pfx
*.pem
*.key
