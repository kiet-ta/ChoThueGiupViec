# Frontend L1: lint staged files
cd "$(git rev-parse --show-toplevel)/Frontend" || exit 1
FILES=$(git diff --cached --name-only --diff-filter=ACMR -- . | grep -E '\.(ts|tsx|js|jsx)$' | sed 's#^Frontend/##')
if [ -n "$FILES" ]; then
  echo "[frontend] oxlint (staged files)"
  npx --no-install oxlint $FILES || exit 1
fi