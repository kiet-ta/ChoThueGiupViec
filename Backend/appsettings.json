    "Vol": {
      "Threshold": 100.0,
      "ResizeWidthPx": 640
    },
    "Photos": {
      "MinPerPhase": 3,
      "MaxPerPhase": 5
    },
    "Payments": {
      "QrExpiryMinutes": 15,
      "ReconcileAfterMinutes": 3,
      "ReconcileIntervalSeconds": 60
