{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=ChoThueGiupViec;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Stripe": {
    "PublishableKey": "pk_test_xxx",
    "SecretKey": "sk_test_xxx"
  },
  "MoMo": {
    "PartnerCode": "MOMO_SANDBOX_PARTNER",
    "AccessKey": "MOMO_SANDBOX_ACCESS_KEY",
    "SecretKey": "MOMO_SANDBOX_SECRET_KEY_PLACEHOLDER",
    "Endpoint": "https://test-payment.momo.vn/v2/gateway/api/create",
