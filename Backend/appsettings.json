    "Ekyc": {
      "AutoApproveConfidence": 85.00,
      "Fake": {
        "Confidence": 92.00
      },
      "AuditRate": 0.20,
      "FullAuditFirstJobs": 5
    },
    "Otp": {
      "Length": 6,
      "TtlMinutes": 5,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxPerPhonePerHour": 5,
      "MaxPerIpPerHour": 20
    },
    "Subscription": {
      "GraceDays": 7
    },
    "Agency": {
      "MinEscrowBalance": 5000000
    },
    "Sla": {
      "InitialScore": 100.00,
      "Penalty": {
        "NoShow": 20,
        "Shortage": 10,
        "QualityComplaint": 5
      },
      "WarnAtOrBelow": 70,
      "BlockPremiumBelow": 50,
      "AppealHours": 48
    },
    "SuperFreelancer": {
      "MinRating": 4.80,
      "MinCompletedJobs": 50,
      "NoUpheldDisputeDays": 180,
      "RevokeBelowRating": 4.70
    },
    "Premium": {
      "MinLeadHours": 4
    },
    "Rating": {
      "WindowHours": 48,
      "LowStarThreshold": 2,
      "ConsecutiveLowToFlag": 3,
      "MinAvgAfterJobs": {
        "Rating": 4.00,
        "Jobs": 10
      }
    },
    "Cancel": {
      "FullRefundHoursBefore": 2,
      "LateFeeRate": 0.40,
      "WorkerCancelLockCount": 3,
      "WorkerCancelWindowDays": 30
    },
    "Auth": {
      "MinPasswordLength": 10,
      "LockoutFailures": 5,
      "LockoutMinutes": 15,
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30,
      "RegistrationTokenMinutes": 30
    },
    "Privacy": {
      "PhoneVisibleBeforeMinutes": 60,
      "PhoneVisibleAfterMinutes": 60
    },
    "Customer": {
      "InitialTrustScore": 0.00
    },
    "Address": {
      "RoomMaxAreaM2": 30,
      "HouseMaxFloors": 10
    }
