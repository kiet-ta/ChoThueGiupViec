  "Otp": {
    "Provider": "Fake",
    "ApiKey": "OTP_API_KEY_PLACEHOLDER"
  },
  "Ekyc": {
    "Provider": "Fake",
    "ApiKey": "EKYC_API_KEY_PLACEHOLDER"
  },
  "FileStorage": {
    "Provider": "Local",
    "BasePath": "App_Data/Uploads"
  },
  "BusinessRules": {
    "Shift": {
      "MaxHours": 4
    },
    "Area": {
      "StandardMaxM2": 80
    },
    "Gps": {
      "CheckInToleranceMeters": 100.0
    },
    "Dispatch": {
      "RadiusStepsKm": [ 5.0, 7.0, 10.0 ],
      "OfferTimeoutSeconds": 30
    },
    "Commission": {
      "Freelancer": 0.200
    },
    "Absence": {
      "FeeRate": 0.40,
      "MinWaitMinutes": 15,
      "MinCallAttempts": 2,
      "CustomerDisputeHours": 24
