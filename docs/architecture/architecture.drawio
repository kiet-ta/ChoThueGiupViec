        </mxCell>
        <mxCell id="t2-26" value="Ports: a module calls the port another module implements (arrow: consumer to implementer)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="46" width="1800" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="t2-27" value="Domain events: a module publishes, another module handles (arrow: publisher to handler)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1146" width="1800" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="t2-28" value="Also shared by many modules (no arrows): IAuditLog (implemented in Admin), IClock, ICurrentUser, IFileStorage, IGeoService, INotificationService (Infrastructure/Realtime), IPasswordHasher (Identity), IOtpSender (Fake only)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1026" width="1266" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="t2-29" value="Handled by the same module (no arrow): SubscriptionActivated (Agencies), CustomerAbsentApproved (Admin), RatingSubmitted (Ratings)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="2086" width="760" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="t2-30" value="Published with no handler in code: JobAssigned, IncidentReported, DisputeResolved, PayoutBatchClosed, ExtensionPaid, OrderRefunded." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
